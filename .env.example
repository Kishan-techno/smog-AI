# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (leave blank or use local MongoDB; falls back to in-memory MongoDB server in dev if unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017/smog_saathi

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# Caching (seconds)
AQI_CACHE_TTL_SECONDS=600
WEATHER_CACHE_TTL_SECONDS=900

# External Air Quality APIs (optional — Open-Meteo AQI + Weather work without keys)
WAQI_TOKEN=
OPENAQ_API_KEY=

# ML Service
ML_SERVICE_URL=http://127.0.0.1:8000

# GenAI LLM (optional — grounded local RAG synthesis runs if blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
